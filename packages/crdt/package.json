{
  "name": "starling-crdt",
  "version": "0.1.0",
  "description": "A from-scratch Fugue/RGA CRDT for collaborative plain text: no runtime dependencies, a compact binary wire format, tombstone-based deletion, and id-based anchors for cursors that survive concurrent edits.",
  "type": "module",
  "scripts": {
    "prepack": "tsc -b"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u7k4rs6/Starling.git",
    "directory": "packages/crdt"
  },
  "homepage": "https://github.com/u7k4rs6/Starling/tree/main/packages/crdt",
  "keywords": [
    "crdt",
    "fugue",
    "rga",
    "collaborative-editing",
    "real-time-collaboration",
    "text-editing",
    "operational-transform"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {}
}
