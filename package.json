  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/eslint-plugin": "^1.1.25",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
